{
    "$schema": "https://json-schema.org/schema",
    "title": "k8s-inference values",
    "type": "object",
    "properties": {
        "registry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "create",
                "username",
                "token"
            ],
            "properties": {
                "create": {
                    "type": "boolean"
                },
                "username": {
                    "type": "string"
                },
                "token": {
                    "type": "string"
                }
            },
            "if": {
                "properties": {
                    "create": {
                        "const": true
                    }
                }
            },
            "then": {
                "properties": {
                    "username": {
                        "minLength": 1,
                        "pattern": "^[^<>\\s]+$"
                    },
                    "token": {
                        "minLength": 1,
                        "pattern": "^[^<>\\s]+$"
                    }
                }
            },
            "else": {
                "properties": {
                    "username": {
                        "maxLength": 0
                    },
                    "token": {
                        "maxLength": 0
                    }
                }
            }
        },
        "supervisor": {
            "type": "object",
            "properties": {
                "config": {
                    "type": "object",
                    "properties": {
                        "acceptor-url": {
                            "type": "string",
                            "pattern": "^https://[^/?#@]+/?$"
                        }
                    }
                }
            }
        },
        "worker": {
            "type": "object",
            "properties": {
                "coderUrl": {
                    "type": "string"
                },
                "judgeAcceptThreshold": {
                    "type": "number",
                    "minimum": 0.8,
                    "maximum": 1
                },
                "repoPolicies": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "required": [
                            "context_files",
                            "editable_files",
                            "validation_argv"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "context_files": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 20,
                                "uniqueItems": true,
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            },
                            "editable_files": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 20,
                                "uniqueItems": true,
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            },
                            "validation_argv": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 32,
                                "items": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 1024
                                }
                            },
                            "validation_timeout": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 600
                            }
                        }
                    }
                }
            }
        },
        "gateway": {
            "type": "object",
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "trustTlsProxy": {
                                "const": true
                            }
                        },
                        "required": [
                            "trustTlsProxy"
                        ]
                    },
                    "then": {
                        "properties": {
                            "trustedTlsProxyCidrs": {
                                "minItems": 1
                            }
                        },
                        "required": [
                            "trustedTlsProxyCidrs"
                        ]
                    }
                }
            ],
            "properties": {
                "auth": {
                    "type": "object",
                    "required": [
                        "existingSecret",
                        "token"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "existingSecret": {
                            "type": "string",
                            "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                            "maxLength": 253
                        },
                        "token": {
                            "type": "string",
                            "pattern": "^[^<>\\s]*$"
                        }
                    },
                    "oneOf": [
                        {
                            "properties": {
                                "existingSecret": {
                                    "minLength": 1
                                },
                                "token": {
                                    "maxLength": 0
                                }
                            }
                        },
                        {
                            "properties": {
                                "existingSecret": {
                                    "maxLength": 0
                                },
                                "token": {
                                    "minLength": 32
                                }
                            }
                        }
                    ]
                },
                "trustTlsProxy": {
                    "type": "boolean"
                },
                "trustedTlsProxyCidrs": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "ingress": {
                    "type": "object",
                    "required": [
                        "host",
                        "tlsSecretName"
                    ],
                    "properties": {
                        "host": {
                            "type": "string",
                            "minLength": 1
                        },
                        "tlsSecretName": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "taskCredentialTtlSeconds": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 604800
                },
                "persistence": {
                    "type": "object",
                    "required": [
                        "size",
                        "storageClassName",
                        "existingClaim"
                    ],
                    "properties": {
                        "size": {
                            "type": "string",
                            "minLength": 1
                        },
                        "storageClassName": {
                            "type": "string"
                        },
                        "existingClaim": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "global": {
            "type": "object",
            "properties": {
                "IMAGE_REGISTRY": {
                    "type": "string"
                },
                "imagePullSecrets": {
                    "type": "string"
                }
            }
        },
        "IMAGE": {
            "type": "string"
        },
        "WORKER_IMAGE": {
            "type": "string"
        },
        "namespaces": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean"
                },
                "inference": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "labels": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                },
                "orchestrator": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "labels": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "nvidia-device-plugin": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "allowDefaultNamespace": {
                    "type": "boolean"
                },
                "namespaceOverride": {
                    "type": "string"
                },
                "inference": {
                    "type": "object",
                    "properties": {
                        "image": {
                            "type": "string"
                        },
                        "imagePullPolicy": {
                            "type": "string"
                        },
                        "real": {
                            "type": "boolean"
                        },
                        "verified": {
                            "type": "string"
                        },
                        "configMaps": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "model": {
                                        "type": "object",
                                        "properties": {
                                            "model-dir": {
                                                "type": "string"
                                            },
                                            "model-format": {
                                                "type": "string"
                                            },
                                            "model-name": {
                                                "type": "string"
                                            },
                                            "ctx-size": {
                                                "type": "string"
                                            },
                                            "tensor-type": {
                                                "type": "string"
                                            },
                                            "rope-freq-base": {
                                                "type": "string"
                                            },
                                            "rope-freq-scale": {
                                                "type": "string"
                                            },
                                            "port": {
                                                "type": "string"
                                            },
                                            "host": {
                                                "type": "string"
                                            },
                                            "keep-ctx": {
                                                "type": "string"
                                            },
                                            "no-display": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "gpuDeviceIds": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "cpuRequest": {
                                    "type": "string"
                                },
                                "cpuLimit": {
                                    "type": "string"
                                },
                                "gpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "ingress": {
                            "type": "object",
                            "properties": {
                                "host": {
                                    "type": "string"
                                },
                                "path": {
                                    "type": "string"
                                },
                                "entrypoints": {
                                    "type": "string"
                                },
                                "middlewares": {
                                    "type": "string"
                                },
                                "method": {
                                    "type": "string"
                                }
                            }
                        },
                        "pvc": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "storageClassName": {
                                    "type": "string"
                                },
                                "accessMode": {
                                    "type": "string"
                                },
                                "size": {
                                    "type": "string"
                                },
                                "mountPath": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "orchestrator": {
            "type": "object",
            "properties": {
                "image": {
                    "type": "string"
                },
                "imagePullPolicy": {
                    "type": "string"
                },
                "real": {
                    "type": "boolean"
                },
                "verified": {
                    "type": "string"
                },
                "openaiApiKey": {
                    "type": "string"
                },
                "config": {
                    "type": "object",
                    "properties": {
                        "max-iterations": {
                            "type": "string"
                        },
                        "openai-api-key": {
                            "type": "string"
                        },
                        "task-wait-seconds": {
                            "type": "string"
                        },
                        "loop-state-dir": {
                            "type": "string"
                        },
                        "judge-url": {
                            "type": "string"
                        },
                        "judge-model": {
                            "type": "string"
                        }
                    }
                },
                "judge": {
                    "type": "object",
                    "properties": {
                        "host": {
                            "type": "string"
                        },
                        "port": {
                            "type": "string"
                        }
                    }
                },
                "ingress": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "ingressClassName": {
                            "type": "string"
                        },
                        "entrypoints": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}