{
    "$schema": "https://json-schema.org/schema",
    "definitions": {
        "secretReference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "key"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "maxLength": 253,
                    "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                },
                "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[-._A-Za-z0-9]+$"
                }
            }
        }
    },
    "title": "orchestrator values",
    "type": "object",
    "properties": {
        "githubAuth": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "audience",
                "appId",
                "managementServiceSecret"
            ],
            "properties": {
                "audience": {
                    "type": "string",
                    "maxLength": 256,
                    "minLength": 1,
                    "pattern": "^https://[^<>\\s]+$"
                },
                "appId": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                },
                "privateKeyPem": {
                    "type": "string"
                },
                "privateKeySecret": {
                    "$ref": "#/definitions/secretReference"
                },
                "managementServiceSecret": {
                    "$ref": "#/definitions/secretReference"
                },
                "workflowPolicy": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "ref",
                        "workflow",
                        "events"
                    ],
                    "properties": {
                        "ref": {
                            "type": "string",
                            "pattern": "^refs/heads/[A-Za-z0-9_.\\-/]+$"
                        },
                        "workflow": {
                            "type": "string",
                            "pattern": "^\\.github/workflows/[A-Za-z0-9_-]+\\.ya?ml$"
                        },
                        "events": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                                "enum": [
                                    "issues",
                                    "workflow_dispatch"
                                ]
                            }
                        }
                    }
                },
                "repositories": {
                    "type": "array",
                    "maxItems": 100,
                    "uniqueItems": true,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "repository",
                            "repository_id",
                            "repository_owner_id",
                            "installation_id",
                            "bindings"
                        ],
                        "properties": {
                            "repository": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
                                "not": {
                                    "pattern": "^\\.{1,2}/|/\\.{1,2}$"
                                }
                            },
                            "repository_id": {
                                "type": "string",
                                "pattern": "^[1-9][0-9]*$"
                            },
                            "repository_owner_id": {
                                "type": "string",
                                "pattern": "^[1-9][0-9]*$"
                            },
                            "installation_id": {
                                "type": "string",
                                "pattern": "^[1-9][0-9]*$"
                            },
                            "bindings": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 32,
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                        "workflow_ref",
                                        "ref",
                                        "sub",
                                        "event_name"
                                    ],
                                    "properties": {
                                        "workflow_ref": {
                                            "type": "string",
                                            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/\\.github/workflows/drain\\.yaml@refs/heads/[^\\s]+$"
                                        },
                                        "ref": {
                                            "type": "string",
                                            "pattern": "^refs/heads/[^\\s]+$"
                                        },
                                        "sub": {
                                            "type": "string",
                                            "pattern": "^repo:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+:ref:refs/heads/[^\\s]+$"
                                        },
                                        "event_name": {
                                            "enum": [
                                                "issues",
                                                "workflow_dispatch"
                                            ]
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "anyOf": [
                {
                    "required": [
                        "workflowPolicy"
                    ]
                },
                {
                    "required": [
                        "repositories"
                    ],
                    "properties": {
                        "repositories": {
                            "minItems": 1
                        }
                    }
                }
            ],
            "if": {
                "required": [
                    "privateKeyPem"
                ],
                "properties": {
                    "privateKeyPem": {
                        "pattern": "\\S"
                    }
                }
            },
            "else": {
                "required": [
                    "privateKeySecret"
                ],
                "properties": {
                    "privateKeySecret": {
                        "properties": {
                            "name": {
                                "minLength": 1
                            }
                        }
                    }
                }
            }
        },
        "management": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "github": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "clientId",
                        "clientSecret"
                    ],
                    "properties": {
                        "clientId": {
                            "type": "string",
                            "maxLength": 256,
                            "pattern": "^[A-Za-z0-9_.-]*$"
                        },
                        "clientSecret": {
                            "$ref": "#/definitions/secretReference"
                        }
                    },
                    "if": {
                        "properties": {
                            "clientId": {
                                "minLength": 1
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "clientSecret": {
                                "properties": {
                                    "name": {
                                        "minLength": 1
                                    }
                                }
                            }
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "authMode": {
                    "enum": [
                        "admin",
                        "oidc"
                    ]
                },
                "admin": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "username": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_.-]+$"
                        },
                        "password": {
                            "type": "string"
                        },
                        "passwordSecret": {
                            "$ref": "#/definitions/secretReference"
                        }
                    },
                    "not": {
                        "required": [
                            "password",
                            "passwordSecret"
                        ],
                        "properties": {
                            "password": {
                                "minLength": 1
                            },
                            "passwordSecret": {
                                "properties": {
                                    "name": {
                                        "minLength": 1
                                    }
                                }
                            }
                        }
                    }
                },
                "image": {
                    "type": "string"
                },
                "imagePullPolicy": {
                    "enum": [
                        "Always",
                        "IfNotPresent",
                        "Never"
                    ]
                },
                "publicOrigin": {
                    "type": "string"
                },
                "gatewayUrl": {
                    "type": "string",
                    "pattern": "^(https://[^@?#]+)?$"
                },
                "ingress": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "host": {
                            "type": "string",
                            "maxLength": 253
                        },
                        "tlsTermination": {
                            "enum": [
                                "internal",
                                "external"
                            ]
                        },
                        "tlsSecretName": {
                            "type": "string",
                            "maxLength": 253,
                            "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                        }
                    }
                },
                "oidc": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "issuer": {
                            "type": "string"
                        },
                        "audience": {
                            "type": "string"
                        },
                        "jwksUrl": {
                            "type": "string"
                        },
                        "allowedSubjects": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "^[^,]+$"
                            }
                        }
                    }
                }
            },
            "if": {
                "properties": {
                    "enabled": {
                        "const": true
                    }
                },
                "required": [
                    "enabled"
                ]
            },
            "then": {
                "required": [
                    "image",
                    "publicOrigin",
                    "authMode"
                ],
                "if": {
                    "properties": {
                        "authMode": {
                            "const": "admin"
                        }
                    }
                },
                "then": {
                    "required": [
                        "admin"
                    ],
                    "properties": {
                        "admin": {
                            "required": [
                                "username"
                            ],
                            "anyOf": [
                                {
                                    "required": [
                                        "password"
                                    ],
                                    "properties": {
                                        "password": {
                                            "minLength": 8,
                                            "pattern": "^[^<>\\s]*[^A-Za-z0-9<>\\s][^<>\\s]*$"
                                        }
                                    }
                                },
                                {
                                    "required": [
                                        "passwordSecret"
                                    ],
                                    "properties": {
                                        "passwordSecret": {
                                            "properties": {
                                                "name": {
                                                    "minLength": 1
                                                }
                                            }
                                        }
                                    }
                                }
                            ],
                            "properties": {
                                "username": {
                                    "minLength": 1
                                }
                            }
                        }
                    }
                },
                "else": {
                    "required": [
                        "oidc"
                    ],
                    "properties": {
                        "oidc": {
                            "required": [
                                "issuer",
                                "audience",
                                "jwksUrl",
                                "allowedSubjects"
                            ],
                            "properties": {
                                "issuer": {
                                    "pattern": "^https://[^@?#]+$"
                                },
                                "audience": {
                                    "minLength": 1
                                },
                                "jwksUrl": {
                                    "pattern": "^https://[^@#]+$"
                                },
                                "allowedSubjects": {
                                    "minItems": 1
                                }
                            }
                        }
                    }
                },
                "properties": {
                    "image": {
                        "minLength": 1
                    },
                    "publicOrigin": {
                        "pattern": "^https://[^/@?#]+$"
                    },
                    "ingress": {
                        "if": {
                            "properties": {
                                "enabled": {
                                    "const": true
                                }
                            },
                            "required": [
                                "enabled"
                            ]
                        },
                        "then": {
                            "required": [
                                "host",
                                "tlsTermination"
                            ],
                            "properties": {
                                "host": {
                                    "minLength": 1,
                                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                                }
                            },
                            "if": {
                                "properties": {
                                    "tlsTermination": {
                                        "const": "internal"
                                    }
                                }
                            },
                            "then": {
                                "required": [
                                    "tlsSecretName"
                                ],
                                "properties": {
                                    "tlsSecretName": {
                                        "minLength": 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "credentials": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "internal": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "supervisorServiceToken": {
                            "type": "string",
                            "pattern": "^$|^[^<>\\s]+$"
                        },
                        "supervisorServiceSecret": {
                            "$ref": "#/definitions/secretReference"
                        }
                    },
                    "not": {
                        "required": [
                            "supervisorServiceToken",
                            "supervisorServiceSecret"
                        ],
                        "properties": {
                            "supervisorServiceToken": {
                                "minLength": 1
                            },
                            "supervisorServiceSecret": {
                                "properties": {
                                    "name": {
                                        "minLength": 1
                                    }
                                }
                            }
                        }
                    }
                },
                "github": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "ghcrReadPackagesPat": {
                            "type": "string"
                        }
                    }
                },
                "models": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "openaiApiKey": {
                            "type": "string",
                            "pattern": "^$|^[^<>\\s]+$"
                        },
                        "coderApiKey": {
                            "type": "string",
                            "pattern": "^$|^[^<>\\s]+$"
                        },
                        "openaiSecret": {
                            "$ref": "#/definitions/secretReference"
                        },
                        "coderSecret": {
                            "$ref": "#/definitions/secretReference"
                        }
                    },
                    "allOf": [
                        {
                            "not": {
                                "required": [
                                    "openaiApiKey",
                                    "openaiSecret"
                                ],
                                "properties": {
                                    "openaiApiKey": {
                                        "minLength": 1
                                    },
                                    "openaiSecret": {
                                        "properties": {
                                            "name": {
                                                "minLength": 1
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "not": {
                                "required": [
                                    "coderApiKey",
                                    "coderSecret"
                                ],
                                "properties": {
                                    "coderApiKey": {
                                        "minLength": 1
                                    },
                                    "coderSecret": {
                                        "properties": {
                                            "name": {
                                                "minLength": 1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        },
        "registry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "create",
                "username"
            ],
            "properties": {
                "create": {
                    "type": "boolean"
                },
                "username": {
                    "type": "string"
                }
            },
            "if": {
                "properties": {
                    "create": {
                        "const": true
                    }
                }
            },
            "then": {
                "properties": {
                    "username": {
                        "minLength": 1,
                        "pattern": "^[^<>\\s]+$"
                    }
                }
            },
            "else": {
                "properties": {
                    "username": {
                        "maxLength": 0
                    }
                }
            }
        },
        "supervisor": {
            "type": "object",
            "properties": {
                "auth": {
                    "not": {},
                    "description": "Set credentials.internal.supervisorServiceToken in helm/local.secrets-values.yaml."
                },
                "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "acceptor-url": {
                            "type": "string",
                            "pattern": "^https://[^/?#@]+/?$"
                        },
                        "coder-url": {
                            "type": "string",
                            "pattern": "^https?://[^/?#@]+/v1$"
                        },
                        "judge-url": {
                            "type": "string",
                            "pattern": "^https?://[^/?#@]+/v1$"
                        },
                        "coder-model": {
                            "type": "string",
                            "minLength": 1
                        },
                        "judge-model": {
                            "type": "string",
                            "minLength": 1
                        },
                        "acceptance-threshold": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "max-total-attempts": {
                            "type": "integer",
                            "const": 8
                        },
                        "allowed-base-branches": {
                            "type": "string"
                        },
                        "reviewers": {
                            "type": "string"
                        },
                        "worker-parallelism": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "max-iterations": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "task-wait-seconds": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "loop-state-dir": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            }
        },
        "agentCatalog": {
            "type": "object",
            "required": [
                "version"
            ],
            "additionalProperties": false,
            "properties": {
                "version": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "worker": {
            "type": "object",
            "properties": {
                "auth": {
                    "not": {},
                    "description": "Set credentials.models.coderApiKey in helm/local.secrets-values.yaml if the endpoint requires authentication."
                },
                "coderUrl": {
                    "type": "string"
                },
                "judgeAcceptThreshold": {
                    "type": "number",
                    "minimum": 0.8,
                    "maximum": 1
                },
                "repoPolicies": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "required": [
                            "context_files",
                            "editable_files",
                            "validation_argv"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "context_files": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 20,
                                "uniqueItems": true,
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            },
                            "editable_files": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 20,
                                "uniqueItems": true,
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            },
                            "validation_argv": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 32,
                                "items": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 1024
                                }
                            },
                            "validation_timeout": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 600
                            }
                        }
                    }
                }
            }
        },
        "gateway": {
            "type": "object",
            "required": [
                "taskJobTtlSecondsAfterFinished",
                "transportMode"
            ],
            "properties": {
                "auth": {
                    "not": {},
                    "description": "Repository submission requires GitHub Actions OIDC or the management service credential."
                },
                "transportMode": {
                    "type": "string",
                    "enum": [
                        "edge-tls"
                    ],
                    "description": "TLS is enforced by deployment infrastructure; restrict access to the HTTP backend."
                },
                "ingress": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "host",
                        "tlsTermination"
                    ],
                    "if": {
                        "properties": {
                            "tlsTermination": {
                                "const": "internal"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "tlsSecretName"
                        ],
                        "properties": {
                            "tlsSecretName": {
                                "minLength": 1
                            }
                        }
                    },
                    "properties": {
                        "host": {
                            "type": "string",
                            "minLength": 1
                        },
                        "tlsTermination": {
                            "type": "string",
                            "enum": [
                                "internal",
                                "external"
                            ]
                        },
                        "tlsSecretName": {
                            "type": "string"
                        }
                    }
                },
                "taskCredentialTtlSeconds": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 604800
                },
                "taskJobTtlSecondsAfterFinished": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 604800
                },
                "persistence": {
                    "type": "object",
                    "required": [
                        "size",
                        "storageClassName",
                        "existingClaim"
                    ],
                    "properties": {
                        "size": {
                            "type": "string",
                            "minLength": 1
                        },
                        "storageClassName": {
                            "type": "string"
                        },
                        "existingClaim": {
                            "type": "string"
                        },
                        "accessMode": {
                            "type": "string",
                            "enum": [
                                "ReadWriteOnce",
                                "ReadWriteMany"
                            ]
                        }
                    }
                }
            }
        },
        "global": {
            "type": "object",
            "properties": {
                "IMAGE_REGISTRY": {
                    "type": "string"
                },
                "imagePullSecrets": {
                    "type": "string"
                }
            }
        },
        "IMAGE": {
            "type": "string"
        },
        "WORKER_IMAGE": {
            "type": "string"
        },
        "namespaces": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean"
                },
                "inference": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "labels": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                },
                "orchestrator": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "labels": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "nvidia-device-plugin": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "allowDefaultNamespace": {
                    "type": "boolean"
                },
                "namespaceOverride": {
                    "type": "string"
                },
                "inference": {
                    "type": "object",
                    "properties": {
                        "image": {
                            "type": "string"
                        },
                        "imagePullPolicy": {
                            "type": "string"
                        },
                        "real": {
                            "type": "boolean"
                        },
                        "verified": {
                            "type": "string"
                        },
                        "configMaps": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "model": {
                                        "type": "object",
                                        "properties": {
                                            "model-dir": {
                                                "type": "string"
                                            },
                                            "model-format": {
                                                "type": "string"
                                            },
                                            "model-name": {
                                                "type": "string"
                                            },
                                            "ctx-size": {
                                                "type": "string"
                                            },
                                            "tensor-type": {
                                                "type": "string"
                                            },
                                            "rope-freq-base": {
                                                "type": "string"
                                            },
                                            "rope-freq-scale": {
                                                "type": "string"
                                            },
                                            "port": {
                                                "type": "string"
                                            },
                                            "host": {
                                                "type": "string"
                                            },
                                            "keep-ctx": {
                                                "type": "string"
                                            },
                                            "no-display": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "gpuDeviceIds": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "cpuRequest": {
                                    "type": "string"
                                },
                                "cpuLimit": {
                                    "type": "string"
                                },
                                "gpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "ingress": {
                            "type": "object",
                            "properties": {
                                "host": {
                                    "type": "string"
                                },
                                "path": {
                                    "type": "string"
                                },
                                "entrypoints": {
                                    "type": "string"
