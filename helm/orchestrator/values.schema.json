{
    "$schema": "https://json-schema.org/schema",
    "title": "orchestrator values",
    "type": "object",
    "properties": {
        "credentials": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "internal": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "gatewayClientToken": {
                            "type": "string"
                        },
                        "supervisorServiceToken": {
                            "type": "string"
                        }
                    }
                },
                "github": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "ghcrReadPackagesPat": {
                            "type": "string"
                        },
                        "pullRequestPat": {
                            "type": "string"
                        }
                    }
                },
                "models": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "openaiApiKey": {
                            "type": "string"
                        },
                        "coderApiKey": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "registry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "create",
                "username"
            ],
            "properties": {
                "create": {
                    "type": "boolean"
                },
                "username": {
                    "type": "string"
                }
            },
            "if": {
                "properties": {
                    "create": {
                        "const": true
                    }
                }
            },
            "then": {
                "properties": {
                    "username": {
                        "minLength": 1,
                        "pattern": "^[^<>\\s]+$"
                    }
                }
            },
            "else": {
                "properties": {
                    "username": {
                        "maxLength": 0
                    }
                }
            }
        },
        "supervisor": {
            "type": "object",
            "properties": {
                "auth": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "existingSecret",
                        "pullRequestSecret",
                        "createSecret"
                    ],
                    "properties": {
                        "existingSecret": {
                            "type": "string",
                            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                            "maxLength": 253
                        },
                        "createSecret": {
                            "type": "boolean"
                        },
                        "pullRequestSecret": {
                            "type": "string",
                            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                            "maxLength": 253
                        }
                    }
                },
                "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "acceptor-url": {
                            "type": "string",
                            "pattern": "^https://[^/?#@]+/?$"
                        },
                        "coder-url": {
                            "type": "string",
                            "pattern": "^https?://[^/?#@]+/v1$"
                        },
                        "judge-url": {
                            "type": "string",
                            "pattern": "^https?://[^/?#@]+/v1$"
                        },
                        "coder-model": {
                            "type": "string",
                            "minLength": 1
                        },
                        "judge-model": {
                            "type": "string",
                            "minLength": 1
                        },
                        "acceptance-threshold": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "max-total-attempts": {
                            "type": "integer",
                            "const": 8
                        },
                        "allowed-base-branches": {
                            "type": "string"
                        },
                        "reviewers": {
                            "type": "string"
                        },
                        "worker-parallelism": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "max-iterations": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "task-wait-seconds": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "loop-state-dir": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            }
        },
        "agentCatalog": {
            "type": "object",
            "required": [
                "version"
            ],
            "additionalProperties": false,
            "properties": {
                "version": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "worker": {
            "type": "object",
            "properties": {
                "auth": {
                    "type": "object",
                    "required": [
                        "existingSecret"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "existingSecret": {
                            "type": "string",
                            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                            "maxLength": 253
                        },
                        "createSecret": {
                            "type": "boolean"
                        }
                    }
                },
                "coderUrl": {
                    "type": "string"
                },
                "judgeAcceptThreshold": {
                    "type": "number",
                    "minimum": 0.8,
                    "maximum": 1
                },
                "repoPolicies": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "required": [
                            "context_files",
                            "editable_files",
                            "validation_argv"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "context_files": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 20,
                                "uniqueItems": true,
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            },
                            "editable_files": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 20,
                                "uniqueItems": true,
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            },
                            "validation_argv": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 32,
                                "items": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 1024
                                }
                            },
                            "validation_timeout": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 600
                            }
                        }
                    }
                }
            }
        },
        "gateway": {
            "type": "object",
            "required": [
                "taskJobTtlSecondsAfterFinished",
                "transportMode"
            ],
            "properties": {
                "auth": {
                    "type": "object",
                    "required": [
                        "existingSecret"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "existingSecret": {
                            "type": "string",
                            "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                            "maxLength": 253
                        }
                    }
                },
                "transportMode": {
                    "type": "string",
                    "enum": [
                        "edge-tls"
                    ],
                    "description": "TLS is enforced by deployment infrastructure; restrict access to the HTTP backend."
                },
                "ingress": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "host",
                        "tlsTermination"
                    ],
                    "if": {
                        "properties": {
                            "tlsTermination": {
                                "const": "internal"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "tlsSecretName"
                        ],
                        "properties": {
                            "tlsSecretName": {
                                "minLength": 1
                            }
                        }
                    },
                    "properties": {
                        "host": {
                            "type": "string",
                            "minLength": 1
                        },
                        "tlsTermination": {
                            "type": "string",
                            "enum": [
                                "internal",
                                "external"
                            ]
                        },
                        "tlsSecretName": {
                            "type": "string"
                        }
                    }
                },
                "taskCredentialTtlSeconds": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 604800
                },
                "taskJobTtlSecondsAfterFinished": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 604800
                },
                "persistence": {
                    "type": "object",
                    "required": [
                        "size",
                        "storageClassName",
                        "existingClaim"
                    ],
                    "properties": {
                        "size": {
                            "type": "string",
                            "minLength": 1
                        },
                        "storageClassName": {
                            "type": "string"
                        },
                        "existingClaim": {
                            "type": "string"
                        },
                        "accessMode": {
                            "type": "string",
                            "enum": [
                                "ReadWriteOnce",
                                "ReadWriteMany"
                            ]
                        }
                    }
                }
            }
        },
        "global": {
            "type": "object",
            "properties": {
                "IMAGE_REGISTRY": {
                    "type": "string"
                },
                "imagePullSecrets": {
                    "type": "string"
                }
            }
        },
        "IMAGE": {
            "type": "string"
        },
        "WORKER_IMAGE": {
            "type": "string"
        },
        "namespaces": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean"
                },
                "inference": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "labels": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                },
                "orchestrator": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "labels": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "nvidia-device-plugin": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "allowDefaultNamespace": {
                    "type": "boolean"
                },
                "namespaceOverride": {
                    "type": "string"
                },
                "inference": {
                    "type": "object",
                    "properties": {
                        "image": {
                            "type": "string"
                        },
                        "imagePullPolicy": {
                            "type": "string"
                        },
                        "real": {
                            "type": "boolean"
                        },
                        "verified": {
                            "type": "string"
                        },
                        "configMaps": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "model": {
                                        "type": "object",
                                        "properties": {
                                            "model-dir": {
                                                "type": "string"
                                            },
                                            "model-format": {
                                                "type": "string"
                                            },
                                            "model-name": {
                                                "type": "string"
                                            },
                                            "ctx-size": {
                                                "type": "string"
                                            },
                                            "tensor-type": {
                                                "type": "string"
                                            },
                                            "rope-freq-base": {
                                                "type": "string"
                                            },
                                            "rope-freq-scale": {
                                                "type": "string"
                                            },
                                            "port": {
                                                "type": "string"
                                            },
                                            "host": {
                                                "type": "string"
                                            },
                                            "keep-ctx": {
                                                "type": "string"
                                            },
                                            "no-display": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "gpuDeviceIds": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "cpuRequest": {
                                    "type": "string"
                                },
                                "cpuLimit": {
                                    "type": "string"
                                },
                                "gpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "ingress": {
                            "type": "object",
                            "properties": {
                                "host": {
                                    "type": "string"
                                },
                                "path": {
                                    "type": "string"
                                },
                                "entrypoints": {
                                    "type": "string"
                                },
                                "middlewares": {
                                    "type": "string"
                                },
                                "method": {
                                    "type": "string"
                                }
                            }
                        },
                        "pvc": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "storageClassName": {
                                    "type": "string"
                                },
                                "accessMode": {
                                    "type": "string"
                                },
                                "size": {
                                    "type": "string"
                                },
                                "mountPath": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "orchestrator": {
            "type": "object",
            "properties": {
                "image": {
                    "type": "string"
                },
                "imagePullPolicy": {
                    "type": "string"
                },
                "real": {
                    "type": "boolean"
                },
                "verified": {
                    "type": "string"
                },
                "config": {
                    "type": "object",
                    "properties": {
                        "max-iterations": {
                            "type": "string"
                        },
                        "task-wait-seconds": {
                            "type": "string"
                        },
                        "loop-state-dir": {
                            "type": "string"
                        },
                        "judge-url": {
                            "type": "string"
                        },
                        "judge-model": {
                            "type": "string"
                        }
                    }
                },
                "judge": {
                    "type": "object",
                    "properties": {
                        "host": {
                            "type": "string"
                        },
                        "port": {
                            "type": "string"
                        }
                    }
                },
                "ingress": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "ingressClassName": {
                            "type": "string"
                        },
                        "entrypoints": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "registry": {
                        "properties": {
                            "create": {
                                "const": true
                            }
                        },
                        "required": [
                            "create"
                        ]
                    }
                },
                "required": [
                    "registry"
                ]
            },
            "then": {
                "properties": {
                    "credentials": {
                        "properties": {
                            "github": {
                                "properties": {
                                    "ghcrReadPackagesPat": {
                                        "minLength": 1,
                                        "pattern": "^[^<>\\s]+$"
                                    }
                                },
                                "required": [
                                    "ghcrReadPackagesPat"
                                ]
                            }
                        },
                        "required": [
                            "github"
                        ]
                    }
                },
                "required": [
                    "credentials"
                ]
            }
        },
        {
            "if": {
                "properties": {
                    "gateway": {
                        "properties": {
                            "auth": {
                                "properties": {
                                    "existingSecret": {
                                        "maxLength": 0
                                    }
                                },
                                "required": [
                                    "existingSecret"
                                ]
                            }
                        },
                        "required": [
                            "auth"
                        ]
                    }
                },
                "required": [
                    "gateway"
                ]
            },
            "then": {
                "properties": {
                    "credentials": {
                        "properties": {
                            "internal": {
                                "properties": {
                                    "gatewayClientToken": {
                                        "minLength": 32,
                                        "pattern": "^[^<>\\s]+$"
                                    }
                                },
                                "required": [
                                    "gatewayClientToken"
                                ]
                            }
                        },
                        "required": [
                            "internal"
                        ]
                    }
                },
                "required": [
                    "credentials"
                ]
            }
        },
        {
            "if": {
                "properties": {
                    "supervisor": {
                        "properties": {
                            "auth": {
                                "properties": {
                                    "createSecret": {
                                        "const": true
                                    }
                                },
                                "required": [
                                    "createSecret"
                                ]
                            }
                        },
                        "required": [
                            "auth"
                        ]
                    }
                },
                "required": [
                    "supervisor"
                ]
            },
            "then": {
                "properties": {
                    "credentials": {
                        "properties": {
                            "internal": {
                                "properties": {
                                    "supervisorServiceToken": {
                                        "minLength": 1,
                                        "pattern": "^[^<>\\s]+$"
                                    }
                                },
                                "required": [
                                    "supervisorServiceToken"
                                ]
                            },
                            "github": {
                                "properties": {
                                    "pullRequestPat": {
                                        "minLength": 1,
                                        "pattern": "^[^<>\\s]+$"
                                    }
                                },
                                "required": [
                                    "pullRequestPat"
                                ]
                            }
                        },
                        "required": [
                            "internal",
                            "github"
                        ]
                    }
                },
                "required": [
                    "credentials"
                ]
            }
        },
        {
            "if": {
                "properties": {
                    "worker": {
                        "properties": {
                            "auth": {
                                "properties": {
                                    "createSecret": {
                                        "const": true
                                    }
                                },
                                "required": [
                                    "createSecret"
                                ]
                            }
                        },
                        "required": [
                            "auth"
                        ]
                    }
                },
                "required": [
                    "worker"
                ]
            },
            "then": {
                "properties": {
                    "credentials": {
                        "properties": {
                            "models": {
                                "properties": {
                                    "coderApiKey": {
                                        "minLength": 1
                                    }
                                },
                                "required": [
                                    "coderApiKey"
                                ]
                            }
                        },
                        "required": [
                            "models"
                        ]
                    }
                },
                "required": [
                    "credentials"
                ]
            }
        }
    ]
}