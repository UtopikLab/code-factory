{
  "$schema": "https://schemas.grafana.com/dashboards/1.0",
  "id": "cfe-orchestrator-monitoring",
  "uid": "cfe-orchestrator",
  "title": "GitHub Agent Orchestrator (CFE)",
  "tags": [
    "orchestrator",
    "cfe",
    "prometheus"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 1,
  "editable": true,
  "annotations": {
    "enableThreshold": 5,
    "enableLabelThreshold": 5,
    "showUnread": false
  },
  "panels": [
    {
      "id": "0",
      "title": "Pipeline Overview",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "gateway requests/s"
        },
        {
          "refId": "B",
          "expr": "rate(gateway_tasks_accepted_total[5m])",
          "legendFormat": "accepted tasks/s"
        },
        {
          "refId": "C",
          "expr": "rate(worker_tasks_total[5m])",
          "legendFormat": "worker tasks/s"
        }
      ]
    },
    {
      "id": "1",
      "title": "Active Workload",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_active_requests_gauge",
          "legendFormat": "gateway active"
        },
        {
          "refId": "B",
          "expr": "worker_active_jobs",
          "legendFormat": "worker active jobs"
        },
        {
          "refId": "C",
          "expr": "gateway_tasks_by_status{status=\"running\"}",
          "legendFormat": "durable tasks running"
        }
      ]
    },
    {
      "id": "2",
      "title": "Gateway: Error Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(http_request_errors_total[5m])",
          "legendFormat": "errors/s"
        }
      ]
    },
    {
      "id": "3",
      "title": "Gateway: Request Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 8
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "id": "4",
      "title": "Gateway: Latency (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 8
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "http_request_duration_seconds_sum/http_request_duration_seconds_count",
          "legendFormat": "avg latency (s)"
        }
      ]
    },
    {
      "id": "5",
      "title": "Gateway: Tasks Accepted",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_tasks_accepted_total",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": "6",
      "title": "Supervisor: Best Score",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 14
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "orchestrator_best_score",
          "legendFormat": "best eval score"
        }
      ]
    },
    {
      "id": "7",
      "title": "Supervisor: Current Iteration",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 14
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "orchestrator_current_iteration",
          "legendFormat": "current iteration"
        }
      ]
    },
    {
      "id": "8",
      "title": "Supervisor: Supervisor State",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 20
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "orchestrator_supervisor_state",
          "legendFormat": "state"
        }
      ]
    },
    {
      "id": "9",
      "title": "Supervisor: Active Tasks",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 20
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_tasks_by_status{status=\"running\"}",
          "legendFormat": "durable tasks running"
        }
      ]
    },
    {
      "id": "10",
      "title": "Worker: Code Changes",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 20
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(worker_code_changes_total[5m])",
          "legendFormat": "code changes/s"
        }
      ]
    },
    {
      "id": "11",
      "title": "Worker: Tasks by Outcome",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 20
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "worker_tasks_total",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": "12",
      "title": "Worker: Job Duration (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 26
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(worker_job_duration_seconds_sum[5m])/rate(worker_job_duration_seconds_count[5m])",
          "legendFormat": "job duration"
        }
      ]
    },
    {
      "id": "13",
      "title": "Worker: Active Jobs",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 26
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "worker_active_jobs",
          "legendFormat": "active jobs"
        }
      ]
    },
    {
      "id": "14",
      "title": "Worker: Last Status",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 26
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "worker_last_status",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": "15",
      "title": "Tasks: Current State",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_tasks_by_status",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s"
}