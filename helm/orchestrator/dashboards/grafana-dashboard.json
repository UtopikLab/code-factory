{
  "$schema": "https://schemas.grafana.com/dashboards/1.0",
  "id": "cfe-orchestrator-monitoring",
  "uid": "cfe-orchestrator",
  "title": "GitHub Agent Orchestrator (CFE)",
  "tags": [
    "orchestrator",
    "cfe",
    "prometheus"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 1,
  "editable": true,
  "annotations": {
    "enableThreshold": 5,
    "enableLabelThreshold": 5,
    "showUnread": false
  },
  "panels": [
    {
      "id": "0",
      "title": "Pipeline Overview",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(cfe_gateway_requests[5m])",
          "legendFormat": "gateway requests/s"
        },
        {
          "refId": "B",
          "expr": "rate(cfe_supervisor_tasks[5m])",
          "legendFormat": "supervisor tasks/s"
        },
        {
          "refId": "C",
          "expr": "rate(cfe_worker_tasks[5m])",
          "legendFormat": "worker tasks/s"
        }
      ]
    },
    {
      "id": "1",
      "title": "Active Workload",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "cfe_gateway_active",
          "legendFormat": "gateway active"
        },
        {
          "refId": "B",
          "expr": "cfe_active_jobs",
          "legendFormat": "worker active jobs"
        },
        {
          "refId": "C",
          "expr": "cfe_active_tasks",
          "legendFormat": "supervisor active tasks"
        }
      ]
    },
    {
      "id": "2",
      "title": "Gateway: Error Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(cfe_gateway_errors[5m])",
          "legendFormat": "errors/s"
        }
      ]
    },
    {
      "id": "3",
      "title": "Gateway: Request Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 8
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(cfe_gateway_requests[5m])",
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "id": "4",
      "title": "Gateway: Latency (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 8
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "cfe_request_duration_sum/cfe_request_duration_count",
          "legendFormat": "avg latency (s)"
        }
      ]
    },
    {
      "id": "5",
      "title": "Supervisor: Tasks Over Time",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "cfe_supervisor_tasks",
          "legendFormat": "total tasks"
        },
        {
          "refId": "B",
          "expr": "cfe_supervisor_iterations",
          "legendFormat": "total iterations"
        }
      ]
    },
    {
      "id": "6",
      "title": "Supervisor: Best Score",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 14
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "cfe_best_score",
          "legendFormat": "best eval score"
        }
      ]
    },
    {
      "id": "7",
      "title": "Supervisor: Current Iteration",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 14
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "cfe_current_iteration",
          "legendFormat": "current iteration"
        }
      ]
    },
    {
      "id": "8",
      "title": "Supervisor: Supervisor State",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 20
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "cfe_supervisor_state",
          "legendFormat": "state"
        }
      ]
    },
    {
      "id": "9",
      "title": "Supervisor: Active Tasks",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 20
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "cfe_active_tasks",
          "legendFormat": "active tasks"
        }
      ]
    },
    {
      "id": "10",
      "title": "Worker: Code Changes",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 20
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(cfe_worker_code_changes[5m])",
          "legendFormat": "code changes/s"
        }
      ]
    },
    {
      "id": "11",
      "title": "Worker: Eval Score",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 20
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "cfe_worker_eval_score",
          "legendFormat": "eval score"
        }
      ]
    },
    {
      "id": "12",
      "title": "Worker: Job Duration (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 26
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "cfe_worker_job_duration_seconds",
          "legendFormat": "job duration"
        }
      ]
    },
    {
      "id": "13",
      "title": "Worker: Active Jobs",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 26
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "cfe_active_jobs",
          "legendFormat": "active jobs"
        }
      ]
    },
    {
      "id": "14",
      "title": "Worker: Last Status",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 26
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "cfe_worker_last_status",
          "legendFormat": "last status"
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s"
}
